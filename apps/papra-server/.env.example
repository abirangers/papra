# Papra server environment variables
# ----------------------------------

# Database
# Turso: DATABASE_URL="libsql://your-db-name.turso.io"
# Local: DATABASE_URL="file:./db.sqlite"
DATABASE_URL=""
DATABASE_AUTH_TOKEN=""

# AI Tagging (Optional)
# See https://ollama.com/
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b"
OLLAMA_EMBEDDING_MODEL="mxbai-embed-large"
